@using ConsoleApplication.Application.Services
@using ConsoleApplication.Domain.Entities
@page "/weatherCustom"
@rendermode InteractiveServer

@if (this.IsLoading)
{
    <div style="text-align: center">
        <div class ="spinner-border"></div>
    </div>
}else
{
    <PageTitle>Weather Custom</PageTitle>

    <h1>Weather Info</h1>

    <div style="width: 50%">
        <div class="form-group">
          <label class="active" for="location">Location </label>
          <input style="padding-top: 1px;" class="form-control" type="text" id="location" value="@locationInfo" readonly>
        </div>

        <div class="form-group" style="padding-top: 5px;">
          <label class="active" for="time">Time </label>
            <input style="padding-top: 1px;" class="form-control" type="text" id="time" value="@weatherInfo?.Time" readonly>
        </div>

        <div class="form-group" style="padding-top: 5px;">
          <label class="active" for="temperature">Temperature </label>
            <input style="padding-top: 1px;" class="form-control" type="text" id="temperature" value="@weatherInfo?.Temperature_2m" readonly>
        </div>

        <div class="form-group" style="padding-top: 5px;">
          <label class="active" for="wind">Wind </label>
            <input style="padding-top: 1px;" class="form-control" type="text" id="wind" value="@weatherInfo?.Wind_Speed_10m" readonly>
        </div>

        <div class="form-group" style="padding-top: 5px;">
            <button style="margin-right: 0.8em;" class="btn btn-primary" @onclick="GetWeatherInfoAsync">Get Data</button>
            <button class="btn btn-primary" @onclick="ResetData">Reset</button>
        </div>
    </div>

}

@code {

    [Inject]
    private ILocationInfoService? locationInfoService { get; set; }

    [Inject]
    private IWeatherService? weatherService { get; set; }

    private string? locationInfo;
    private WeatherInfo? weatherInfo;

    public bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await GetWeatherInfoAsync();
    }

    private async Task GetWeatherInfoAsync()
    {
        if (weatherService == null || locationInfoService == null)
            return;

        IsLoading = true;

        var weather = await weatherService.GetWeatherInfoAsync();
        var location = await locationInfoService.GetAsStringAsync();


        locationInfo = location;
        weatherInfo = weather;

        IsLoading = false;
    }

    private void ResetData()
    {
        locationInfo = null;
        weatherInfo = null;
    }
}
